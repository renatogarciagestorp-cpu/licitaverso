    "documentos": [
     {
      "KEY": "JURISPRUDENCIA-SELECIONADA-5028",
      "FAVORITO": false,
      "DTATUALIZACAO": "20160708",
      "NUMACORDAO": "774",
      "ANOACORDAO": "2016",
      "COLEGIADO": "Plenário",
      "AREA": "Desestatização",
      "TEMA": "Porto organizado",
      "SUBTEMA": "Arrendamento de <em>instalação</em> portuária",
      "ASSUNTO": "",
      "ENUNCIADO": "A ampliação de vigência dos contratos de arrendamentos portuários, para fins de recomposição do equilíbrio econômico-financeiro contratual, deve observar as restrições contidas no art. 19 do Decreto 8.033/2013 e ser utilizada, como meio de reequilíbrio, apenas em situações excepcionais, quando demonstrada a inviabilidade de adoção de outros mecanismos que interfiram na relação entre o poder público e o regulado (a exemplo da alteração dos encargos devidos pelo arrendatário e da estipulação de indenizações), e, subsequentemente, de mecanismos que interfiram nos serviços disponibilizados aos usuários (a exemplo da alteração de tarifas cobradas e da modificação das obrigações contratuais), devendo, em todos os casos, estar devidamente motivada a decisão do administrador.",
      "NUMSUMULA": "",
      "DATASESSAOFORMATADA": "06/04/2016",
      "AUTORTESE": "WALTON ALENCAR RODRIGUES",
      "FUNCAOAUTORTESE": "RELATOR",
      "INDEXACAO": "Requisito, <em>Prorrogação</em> de contrato, Reequilíbrio econômico-financeiro, Princípio da motivação, Consulta",
      "PARADIGMATICO": "Este enunciado foi classificado como paradigmático por tratar-se de resposta a consulta",
      "SCORE": 9638.802
     },
     {
      "KEY": "JURISPRUDENCIA-SELECIONADA-4766",
      "FAVORITO": false,
      "DTATUALIZACAO": "20160708",
      "NUMACORDAO": "774",
      "ANOACORDAO": "2016",
      "COLEGIADO": "Plenário",
      "AREA": "Desestatização",
      "TEMA": "Porto organizado",
      "SUBTEMA": "Arrendamento de <em>instalação</em> portuária",
      "ASSUNTO": "",
      "ENUNCIADO": "O prazo de vigência do contrato unificado de arrendamento portuário não deve extrapolar o menor prazo de vigência remanescente entre as avenças a serem consolidadas, considerando-se uma única <em>prorrogação</em> possível (quando prevista), sob pena de violar a limitação contida no art. 19 do Decreto 8.033/2013 e representar burla ao dever de licitar os arrendamentos portuários, previsto no art. 4º da Lei 12.815/2013.",
      "NUMSUMULA": "",
      "DATASESSAOFORMATADA": "06/04/2016",
